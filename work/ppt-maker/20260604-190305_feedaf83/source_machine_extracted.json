        {
          "shape_id": 3,
          "paragraph": 0,
          "run": 0,
          "text": "02  因果链一：我减掉的不是脂肪，而是人体最大的血糖缓冲区",
          "left": 731520,
          "top": 457200,
          "width": 10728655,
          "height": 731520,
          "font_size_pt": null,
          "bold": false,
          "italic": false
        },
        {
          "shape_id": 5,
          "paragraph": 0,
          "run": 0,
          "text": "46.7kg",
          "left": 914400,
          "top": 2011680,
          "width": 3291840,
          "height": 3474720,
          "font_size_pt": null,
          "bold": false,
          "italic": false
        },
        {
          "shape_id": 5,
          "paragraph": 1,
          "run": 0,
          "text": "骨骼肌总量严重低迷",
          "left": 914400,
          "top": 2011680,
          "width": 3291840,
