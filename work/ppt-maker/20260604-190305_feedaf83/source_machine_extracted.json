          "font_size_pt": null,
          "bold": false,
          "italic": false
        },
        {
          "shape_id": 9,
          "paragraph": 3,
          "run": 0,
          "text": "• 寻找餐后运动时机、抗阻训练抗荷、高质蛋白质补充的黄金交点",
          "left": 6492240,
          "top": 2468880,
