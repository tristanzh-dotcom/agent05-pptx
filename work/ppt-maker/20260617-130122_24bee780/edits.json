    {"slide": 0, "slot_id": "s5_sh8198_p0r0", "new_text": "3 UK plants: Solihull (Range Rover), Castle Bromwich (XJ), Halewood (Discovery)."},
    {"slide": 0, "slot_id": "s5_sh8201_p0r0", "new_text": "Sales"},
    {"slide": 0, "slot_id": "s5_sh8202_p0r0", "new_text": "120+ markets, 4 regional VPs reporting to Global Sales Director."},
    {"slide": 0, "slot_id": "s5_sh8205_p0r0", "new_text": "Quality"},
