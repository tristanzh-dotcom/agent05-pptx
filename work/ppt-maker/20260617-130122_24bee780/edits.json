    {"slide": 1, "slot_id": "s9_sh4_p0r0", "new_text": "Org"},
    {"slide": 1, "slot_id": "s9_sh4_p0r2", "new_text": "Proposal"},
    {"slide": 1, "slot_id": "s9_sh59_p0r0", "new_text": "Flat"},
    {"slide": 1, "slot_id": "s9_sh60_p0r0", "new_text": "Reduce layers from 7 to 4. Direct VP-to-team lead. Faster decisions."},
    {"slide": 1, "slot_id": "s9_sh61_p0r0", "new_text": "EV-First"},
    {"slide": 1, "slot_id": "s9_sh62_p0r0", "new_text": "Consolidate ICE teams into EV unit. Single EV platform org."},
    {"slide": 1, "slot_id": "s9_sh63_p0r0", "new_text": "SW Hub"},
    {"slide": 1, "slot_id": "s9_sh1024_p0r0", "new_text": "Centralize all software engineers under Chief Software Officer."},
    {"slide": 1, "slot_id": "s9_sh1025_p0r0", "new_text": "Regional"},
    {"slide": 1, "slot_id": "s9_sh1027_p0r0", "new_text": "China + US regional hubs with P&L ownership. Local decision-making."},
    {"slide": 1, "slot_id": "s9_sh1028_p0r0", "new_text": "Agile"},
    {"slide": 1, "slot_id": "s9_sh1029_p0r0", "new_text": "Cross-functional squads by vehicle line. Remove functional silos."},
    {"slide": 1, "slot_id": "s9_sh1030_p0r0", "new_text": "Cost"},
    {"slide": 1, "slot_id": "s9_sh1031_p0r0", "new_text": "Shared services hub for HR, Finance, IT. Aim -15% overhead."},
    {"slide": 1, "slot_id": "s9_sh1032_p0r0", "new_text": "Innovate"},
    {"slide": 1, "slot_id": "s9_sh1033_p0r0", "new_text": "Dedicated innovation lab reporting to CEO. 50 FTE ring-fenced."},
    {"slide": 1, "slot_id": "s9_sh1034_p0r0", "new_text": "Sustain."},
    {"slide": 1, "slot_id": "s9_sh1035_p0r0", "new_text": "Chief Sustainability Officer. Net-zero roadmap per BU."},
    {"slide": 1, "slot_id": "s9_sh1066_p0r0", "new_text": "Proposed org reduces cost 12% and cuts time-to-market 30%."},

